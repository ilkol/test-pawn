{
	"name": "pawnlanguage-test",
	"version": "1.3.3",
	"displayName": "Pawn Language TEST VERSION",
	"publisher": "ilkol",
	"engines": {
		"vscode": "^1.83.0"
	},
	"author": {
		"name": "il_kol"
	},
	"repository": {
		"type": "git",
		"directory": "https://github.com/DmitryMukhlisov/test-pawn.git"
	},
	"categories": [
		"Programming Languages",
		"Snippets"
	],
	"icon": "pawn.png",
	"main": "./client/out/extension",
	"galleryBanner": {
		"color": "#005089",
		"theme": "dark"
	},
	"keywords": [
		"pawn",
		"pawno"
	],
	"l10n": "./l10n",
	"contributes": {
		"configuration": [
			{
				"title": "Pawn Language",
				"properties": {
					"PawnLanguage.clearOnBuild": {
						"type": "boolean",
						"default": true,
						"description": "%configuration.clearOnBuild.description%"
					}
				}
			}
		],
		"keybindings": [
			{
				"key": "F5",
				"command": "pawnlanguage.runBuildTask",
				"when": "editorFocus && editorLangId == pawn"
			}
		],
		"snippets": [
			{
				"language": "pawn",
				"path": "./snippets/snippets.code-snippets"
			}
		],
		"languages": [
			{
				"id": "pawn",
				"aliases": [
					"pwn",
					"pawno"
				],
				"extensions": [
					".pwn",
					".inc"
				],
				"icon": {
					"light": "./pawn_dark.svg",
					"dark": "./pawn_dark.svg"
				},
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "pawn",
				"scopeName": "source.pawn.sql",
				"path": "./syntaxes/sql.tmLanguage.json"
			},
			{
				"language": "pawn",
				"scopeName": "source.amxasm",
				"path": "./syntaxes/asm.tmLanguage.json"
			},
			{
				"language": "pawn",
				"scopeName": "source.pawn",
				"path": "./syntaxes/pawn.tmLanguage.json",
				"embeddedLanguages": {
					"source.pawnSQL": "pawnSQL",
					"source.amxasm": "AMX ASM"
				}
			}
		],
		"commands": [
			{
				"command": "pawnlanguage.openParsed",
				"title": "Открыть распаршенный файл"
			},
			{
				"command": "pawnlanguage.parseCurrnetFile",
				"title": "Проаналиировать текущий файл"
			},
			{
				"command": "pawnlanguage.flushFileCache",
				"title": "Очистить кэш текущего файла"
			},
			{
				"command": "pawnlanguage.flushWorkspaceCache",
				"title": "Очистить кэш текущей рабочей области"
			}
		]
	},
	"dependencies": {
		"@vscode/l10n": "^0.0.18",
		"@vscode/vsce": "^3.2.2",
		"antlr4ts": "^0.5.0-alpha.4",
		"crypto": "^1.0.1",
		"findup-sync": "^5.0.0",
		"vsce": "^2.15.0"
	},
	"scripts": {
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"compile": "npm run check-types && node esbuild.js",
		"check-types": "tsc --noEmit",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"vscode:prepublish": "npm run package",
		"package": "npm run check-types && node esbuild.js --production"
	},
	"devDependencies": {
		"@types/deep-diff": "^1.0.5",
		"@types/glob": "^8.1.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.3.0",
		"@types/vscode": "^1.103.0",
		"@typescript-eslint/eslint-plugin": "^8.40.0",
		"@typescript-eslint/parser": "^8.40.0",
		"@vscode/l10n-dev": "^0.0.35",
		"@vscode/test-electron": "^2.3.5",
		"antlr4ts-cli": "^0.5.0-alpha.4",
		"deep-diff": "^1.0.2",
		"esbuild": "^0.25.9",
		"eslint": "^9.13.0",
		"glob": "^10.3.10",
		"mocha": "^10.2.0",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	}
}
