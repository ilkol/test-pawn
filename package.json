{
	"name": "pawnlanguage-test",
	"version": "1.3.3",
	"displayName": "Pawn Language TEST VERSION",
	"publisher": "ilkol",
	"engines": {
		"vscode": "^1.83.0"
	},
	"author": {
		"name": "il_kol"
	},
	"repository": {
		"type": "git",
		"directory": "https://github.com/DmitryMukhlisov/test-pawn.git"
	},
	"categories": [
		"Programming Languages",
		"Snippets"
	],
	"icon": "pawn.png",
	"main": "./client/out/extension",
	"galleryBanner": {
		"color": "#005089",
		"theme": "dark"
	},
	"keywords": [
		"pawn",
		"pawno"
	],
	"l10n": "./l10n",
	"contributes": {
		"configuration": [
			{
				"title": "Pawn Language",
				"properties": {
					"PawnLanguage.clearOnBuild": {
						"type": "boolean",
						"default": true,
						"description": "%configuration.clearOnBuild.description%"
					}
				}
			},
			{
				"languageServerExample.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "verbose",
					"description": "Traces the communication between VS Code and the language server."
				}
			}
		],
		"keybindings": [
			{
				"key": "F5",
				"command": "pawnlanguage.runBuildTask",
				"when": "editorFocus && editorLangId == pawn"
			}
		],
		"snippets": [
			{
				"language": "pawn",
				"path": "./snippets/snippets.code-snippets"
			}
		],
		"languages": [
			{
				"id": "pawn",
				"aliases": [
					"pwn",
					"pawno"
				],
				"extensions": [
					".pwn",
					".inc"
				],
				"icon": {
					"light": "./pawn_dark.svg",
					"dark": "./pawn_dark.svg"
				},
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "pawn",
				"scopeName": "source.pawn.sql",
				"path": "./syntaxes/sql.tmLanguage.json"
			},
			{
				"language": "pawn",
				"scopeName": "source.amxasm",
				"path": "./syntaxes/asm.tmLanguage.json"
			},
			{
				"language": "pawn",
				"scopeName": "source.pawn",
				"path": "./syntaxes/pawn.tmLanguage.json",
				"embeddedLanguages": {
					"source.pawnSQL": "pawnSQL",
					"source.amxasm": "AMX ASM"
				}
			}
		],
		"commands": [
			{
				"command": "pawnlanguage.openParsed",
				"title": "Открыть распаршенный файл"
			},
			{
				"command": "pawnlanguage.parseCurrnetFile",
				"title": "Проаналиировать текущий файл"
			},
			{
				"command": "pawnlanguage.flushFileCache",
				"title": "Очистить кэш текущего файла"
			},
			{
				"command": "pawnlanguage.flushWorkspaceCache",
				"title": "Очистить кэш текущей рабочей области"
			}
		]
	},
	"dependencies": {
		"@vscode/l10n": "^0.0.18",
		"antlr4ts": "^0.5.0-alpha.4",
		"findup-sync": "^5.0.0"
	},
	"scripts": {
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"compile": "npm run check-types && node esbuild.js",
		"check-types": "tsc --noEmit",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc -b -w",
		"vscode:prepublish": "npm run package",
		"package": "npm run check-types && node esbuild.js --production",
		"build:grammar": "antlr4ts -visitor -listener -lib ./server/src/antlr/generated -o ./server/src/antlr/generated ./server/src/antlr/generated/pawn.g4"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/deep-diff": "^1.0.5",
		"@types/mocha": "^10.0.6",
		"@types/node": "^22",
		"@types/vscode": "^1.103.0",
		"@vscode/vsce": "^3.2.2",
		"deep-diff": "^1.0.2",
		"esbuild": "^0.27.3",
		"eslint": "^9.13.0",
		"mocha": "^10.3.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	}
}
