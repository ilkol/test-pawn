{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "pawn",
	"patterns": [
		{
			"include": "#ever_present_context"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#keywords_operators"
		},
		{
			"include": "#enum"
		},
		{
			"include": "#function"
		},
		{
			"include": "#operator_overload"
		},
		{
			"include": "#evaluation_context"
		},
		{
			"include": "#storage_modifier"
		},
		{
			"include": "#new_var"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#var_assigment"
		}
	],
	"repository": {
		"enum": {
			"begin": "^\\s*(enum)\\s*([a-zA-Z_][\\w]*)?(?:\\s*\\(\\s*(<<=)\\s*(\\d+)\\s*\\))?",
			"beginCaptures": {
				"1": {
					"name": "storage.type.enum.pawn"
				},
				"2": {
					"name": "entity.name.type.pawn"
				},
				"3": {
					"name": "keyword.operator.assignment.pawn"
				},
				"4": {
					"name": "constant.numeric.decimal.pawn"
				}
			},
			"end": "}",
			"endCaptures": {
				"0": {
					"name": "punctuation.section.block.end.bracket.curly.enum.pawn"
				}
			},
			"name": "meta.block.enum.pawn",
			"patterns": [
				{
					"begin": "\\G",
					"end": "(?=\\})",
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"match": "\\s*(?:([a-zA-Z_][\\w]*)\\s*:\\s*)?([a-zA-Z_][\\w]*)\\s*((?:\\[.*?\\])|(?:\\{.*?\\}))?(?:\\s*(=)\\s*([^,\\}]+))?\\s*(,)?",
							"captures": {
								"1": {
									"patterns": [
										{
											"include": "#types"
										}
									]
								},
								"2": {
									"name": "variable.other.enummember.pawn"
								},
								"3": {
									"patterns": [
										{
											"include": "#array_operators"
										}
									]
								},
								"4": {
									"name": "keyword.operator.assignment.pawn"
								},
								"5": {
									"patterns": [
										{
											"include": "#language_constants"
										},
										{
											"include": "#enum_number_literal"
										},
										{
											"include": "#operators"
										},
										{
											"include": "#variable"
										}
									]
								},
								"6": {
									"name": "punctuation.separator.comma.pawn"
								}
							}
						}
					]
				}
			]
		},
		"var_assigment": {
			"name": "meta.assigment.pawn",
			"begin": "\\b([a-zA-Z_][\\w]*)((?:\\[.*?\\])|(?:\\{.*?\\}))?\\s*=",
			"beginCaptures": {
				"1": {
					"name": "variable.other.pawn"
				},
				"2": {
					"patterns": [
						{
							"include": "#array_operators"
						}
					]
				}
			},
			"end": "(?=;|\\))",
			"patterns": [
				{
					"match": "([a-zA-Z_][\\w]*(?:\\{[a-zA-Z_][\\w]*(?:\\s*,\\s*[a-zA-Z_][\\w]*)*\\})?)\\s*:\\s*",
					"captures": {
						"1": {
							"patterns": [
								{
									"include": "#types"
								}
							]
						}
					}
				},
				{
					"include": "#evaluation_context"
				},
				{
					"include": "#variable"
				}
			]
		},
		"variable": {
			"match": "\\b(?!true|false|EOS|if|while|for|return|foreach|break|continue|do|else|new|static|const|stock|public|void|bool|Float|char|_\\b)[a-zA-Z_][\\w]*\\b",
			"name": "variable.other.pawn"
		},
		"enum_number_literal": {
			"patterns": [
				{
					"match": "\\b0[xX][0-9a-fA-F]+(?:[uU]?[lL]{0,2})?\\b",
					"name": "constant.numeric.hexadecimal.pawn"
				},
				{
					"match": "\\b0[bB][01]+(?:[uU]?[lL]{0,2})?\\b",
					"name": "constant.numeric.binary.pawn"
				},
				{
					"match": "\\b0[0-7]+(?:[uU]?[lL]{0,2})?\\b",
					"name": "constant.numeric.octal.pawn"
				},
				{
					"match": "\\b[0-9]+(?:[uU]?[lL]{0,2})?\\b",
					"name": "constant.numeric.decimal.pawn"
				}
			]
		},
		"number_literal":{
			"patterns": [
				{
					"include": "#enum_number_literal"
				},
				{
					"match": "\\b[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+\\b",
					"name": "constant.numeric.ip.pawn"
				},
				{
					"match": "\\b[0-9]+\\.\\.[0-9]+\\b",
					"name": "constant.numeric.range.pawn"
				}
			]
		},
		"comments":{
			"patterns": [
				{
					"include": "#block_docs"
				},
				{
					"include": "#line_comment"
				},
				{
					"include": "#block_comment"
				}
			]
		},
		"block_docs":{
			"name": "comment.block.documentation.pawn",
			"begin": "/\\*[!*]+(?:(?:\\n|$)|(?=\\s))",
			"end": "\\*/",
			"patterns": [
				{
					"begin": "(@param)(?:\\s+(\\w+))?(?:\\s+(\\w+))?",
					"beginCaptures": {
						"1":{
							"name": "keyword.other.pawn"
						},
						"2":{
							"patterns": [
								{
									"include": "#type_name"
								}
							]
						},
						"3":{
							"name": "variable.other.pawn"
						}
					},
					"end": "\\r?\\n"
				},
				{
					"begin": "(@return)(?:\\s+(\\w+))?",
					"beginCaptures": {
						"1":{
							"name": "keyword.other.pawn"
						},
						"2":{
							"patterns": [
								{
									"include": "#type_name"
								}
							]
						}
					},
					"end": "\\r?\\n"
				},
				{
					"include": "#docs_old"
				}
			]
		},
		"docs_old":
		{
			"patterns": [
				{
					"begin": "<(summary)>",
					"beginCaptures": {
						"1": {
							"name": "keyword.other.pawn"
						}
					},
					"end": "</(summary)>",
					"endCaptures": {
						"1": {
							"name": "keyword.other.pawn"
						}
					}
				},
				{
					"begin": "<(returns)>",
					"beginCaptures": {
						"1": {
							"name": "keyword.other.pawn"
						}
					},
					"end": "</(returns)>",
					"endCaptures": {
						"1": {
							"name": "keyword.other.pawn"
						}
					}
				}
				,
				{
					"begin": "<(param)\\s+name\\s*=\\s*\"(.+?)\"\\s*>",
					"beginCaptures": {
						"1": {
							"name": "keyword.other.pawn"
						},
						"2": {
							"name": "variable.other.pawn"
						}
					},
					"end": "</(param)>",
					"endCaptures": {
						"1": {
							"name": "keyword.other.pawn"
						}
					}
				}
			]
		},
		"block_comment":{
			"name": "comment.block.pawn",
			"begin": "/\\*",
			"end": "\\*/"
		},
		"block": {
			"begin": "{",
			"end": "}",
			"beginCaptures": {
				"0": {
					"name": "punctuation.section.block.begin.bracket.curly.pawn"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.section.block.end.bracket.curly.pawn"
				}
			},
			"name": "meta.block.pawn",
			"patterns": [
				{
					"include": "#function_body_context"
				}
			]
		},
		"line_comment":{
			"name": "comment.line.pawn",
			"match": "//[^\\n]*"
		},
		"single_line_macro": {
			"match": "^\\s*#define.*(?<![\\\\])(?:\\n|$)",
			"captures": {
				"0": {
					"patterns": [
						{
							"include": "#macro"
						},
						{
							"include": "#comments"
						}
					]
				}
			}
		},
		"ever_present_context": {
			"patterns": [
				{
					"include": "#pragma"
				},
				{
					"include": "#include"
				},
				{
					"include": "#undef"
				},
				{
					"match": "^\\s*(#)endinput",
					"captures": {
						"0": {
							"name": "keyword.control.directive.endinput.pawn"
						},
						"1": {
							"name": "punctuation.definition.directive.pawn"
						}
					}
				},
				{
					"include": "#preprocessor_conditional_range"
				},
				{
					"include": "#single_line_macro"
				},
				{
					"include": "#macro"
				},
				{
					"include": "#preprocessor_conditional_standalone"
				},
				
				{
					"include": "#comments"
				},
				{
					"include": "#line_continuation_character"
				},
				{
					"include": "#perproccesor_warnings_errors"
				},
				{
					"include": "#perproccesor_emit"
				},
				{
					"include": "#macro_argument"
				}
			]
		},
		"undef": {
			"match": "(^\\s*(#)(?:\\s+)?undef\\b)\\s+(\\w+)",
			"captures": {
				"1": {
					"name": "keyword.control.directive.undef.pawn"
				},
				"2": {
					"name": "punctuation.definition.directive.pawn"
				},
				"3": {
					"name": "entity.name.function.preprocessor.pawn"
				}
			},
			"name": "meta.preprocessor.undef.pawn"
		},
		"pragma": {
			"begin": "^\\s*(#)(?:\\s+)?pragma\\b",
			"end": "(?<!\\\\)(?:(?=\\n)|(?<=^\\n|[^\\\\]\\n)(?=$))",
			"beginCaptures": {
				"0": {
					"name": "keyword.control.directive.pragma.pawn"
				},
				"1": {
					"name": "punctuation.definition.directive.pawn"
				}
			},
			"endCaptures": {},
			"name": "meta.preprocessor.pragma.pawn",
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"include": "#string_context"
				},
				{
					"match": "\\s+(library)\\s+(\\w+)",
					"captures": {
						"1": {
							"name": "entity.other.attribute-name.pragma.preprocessor.pawn"
						},
						"2": {
							"name": "string.library.name.pawn"
						}
					}
				},
				{
					"match": "\\s+(tabsize)\\s+(\\d+)",
					"captures": {
						"1": {
							"name": "entity.other.attribute-name.pragma.preprocessor.pawn"
						},
						"2": {
							"name": "constant.numeric.decimal.pawn"
						}
					}
				},
				{
					"match": "[a-zA-Z_$][\\w\\-$]*",
					"name": "entity.other.attribute-name.pragma.preprocessor.pawn"
				},
				{
					"include": "#line_continuation_character"
				}
			]
		},
		"preprocessor_conditional_standalone": {
			"match": "^\\s*(#)(?:\\s+)?(?<!\\w)(endif|else|elseif)(?!\\w)",
			"captures": {
				"1": {
					"name": "punctuation.definition.directive.pawn"
				}
			},
			"name": "keyword.control.directive.$2.pawn"
		},
		"preprocessor_conditional_range": {
			"begin": "^\\s*(#)(?:\\s+)?((if|elseif))",
			"end": "(?<!\\\\)(?:(?=\\n)|(?<=^\\n|[^\\\\]\\n)(?=$))",
			"beginCaptures": {
				"0": {
					"name": "keyword.control.directive.conditional.if.pawn"
				},
				"2": {
					"name": "punctuation.definition.directive.pawn"
				}
			},
			"endCaptures": {},
			"contentName": "meta.preprocessor.conditional",
			"patterns": [
				{
					"include": "#preprocessor_conditional_context"
				}
			]
		},
		"preprocessor_conditional_context": {
			"patterns": [
				{
					"include": "#preprocessor_conditional_defined"
				},
				{
					"include": "#comments"
				},
				{
					"include": "#language_constants"
				},
				{
					"include": "#string_context"
				},
				{
					"include": "#operators"
				},
				{
					"include": "#macro_name"
				},
				{
					"include": "#line_continuation_character"
				}
			]
		},
		"line_continuation_character": {
			"match": "\\\\\\n",
			"name": "constant.character.escape.line-continuation.pawn"
		},
		"preprocessor_conditional_defined": {
			"match": "((?<!\\w)defined(?!\\w))",
			"captures": {
				"1": {
					"name": "keyword.control.directive.conditional.defined.pawn"
				}
			},
			"patterns": [
				{
					"include": "#macro_name"
				}
			]
		},
		"macro_name": {
			"match": "\\b[a-zA-Z_]+\\b",
			"name": "entity.name.function.preprocessor.pawn"
		},
		"macro":{
			"name": "meta.preprocessor.macro.pawn",
			"begin": "^\\s*((#)\\s*define\\b)(?:\\s+)?((?:[a-zA-Z0-9_])*(?!\\w))",
			"beginCaptures": {
				"1":{
					"name": "keyword.control.directive.define.pawn"
				},
				"2":{
					"name": "punctuation.definition.directive.pawn"
				},
				"3": {
					"name": "entity.name.function.preprocessor.pawn"
				}
			},
			"end": "(?<!\\\\)(?:(?=\\n)|(?<=^\\n|[^\\\\]\\n)(?=$))",
			"patterns": [
				{
					"match": "\\G(?:\\s+)?(\\()([^\\(]*)(\\))",
					"captures": {
						"1":{
							"name": "punctuation.definition.parameters.begin.preprocessor.pawn"
						},
						"2":{
							
							"name": "meta.function.preprocessor.parameters.pawn",
							"patterns": [
								{
									"match": "(?<=[(,])(?:\\s+)?((?:[a-zA-Z_]|(?:\\\\u[0-9a-fA-F]{4}|\\\\U[0-9a-fA-F]{8}))(?:[a-zA-Z0-9_]|(?:\\\\u[0-9a-fA-F]{4}|\\\\U[0-9a-fA-F]{8}))*)(?:\\s+)?",
									"captures": {
										"1": {
											"name": "variable.parameter.preprocessor.pawn"
										}
									}
								},
								{
									"match": ",",
									"name": "punctuation.separator.parameters.pawn"
								},
								{
									"match": "\\.\\.\\.",
									"name": "punctuation.vararg-ellipses.variable.parameter.preprocessor.pawn"
								}
							]
						},
						"3":{
							"name": "punctuation.definition.parameters.end.preprocessor.pawn"
						}
					}
				},
				{
					"include": "#macro_argument"
				},
				{
					"include": "#evaluation_context"
				}
			]
		},
		"macro_argument": {
			"match": "##?(?:[a-zA-Z_]|(?:\\\\u[0-9a-fA-F]{4}|\\\\U[0-9a-fA-F]{8}))(?:[a-zA-Z0-9_]|(?:\\\\u[0-9a-fA-F]{4}|\\\\U[0-9a-fA-F]{8}))*(?!\\w)",
			"name": "variable.other.macro.argument.pawn"
		},
		"macro_context": {
			"patterns": [
				{
					"include": "#evaluation_context"
				}
			]
		},
		"include": {
			"begin": "^\\s*((#)\\s*(include|tryinclude))\\b\\s*",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.directive.include.pawn"
				},
				"2": {
					"name": "punctuation.definition.directive.pawn"
				}
			},
			"end": "(?=(?://|/\\*))|(?<!\\\\)(?=\\n)",
			"name": "meta.preprocessor.include.pawn",
			"patterns": [
				{
					"begin": "(\"|<)",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.string.begin.pawn"
						}
					},
					"end": "\"|>",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.pawn"
						}
					},
					"name": "string.quoted.double.include.pawn"
				}
			]
		},
		"perproccesor_warnings_errors": {
			"begin": "^\\s*((#)\\s*(warning|error))\\b\\s*",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.directive.$3.pawn"
				},
				"2": {
					"name": "punctuation.definition.directive.pawn"
				}
			},
			"end": "(?=(?://|/\\*))|(?<!\\\\)(?=\\n)",
			"name": "meta.preprocessor.$3.pawn"
		},
		"perproccesor_emit": {
			"begin": "^\\s*((#)\\s*(emit))\\b\\s*",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.directive.emit.pawn"
				},
				"2": {
					"name": "punctuation.definition.directive.pawn"
				}
			},
			"end": "(?=(?://|/\\*))|(?<!\\\\)(?=\\n)",
			"patterns": [
				{
					"include": "source.amxasm"
				}
			],
			"name": "meta.preprocessor.emit.pawn"
		},
		"declaration_functions": {
			"name": "storage.modifier.$1.pawn",
			"match": "(public|forward|native|stock)"
		},
		"function": {
			"name": "meta.function.pawn",
			"begin": "^\\s*(?:(public|forward|native|stock)\\s+)?(\\s*(?:[a-zA-Z_][0-9a-zA-Z_]*?)?:)?\\s*([@a-zA-Z_][0-9a-zA-Z_]*(?::[a-zA-Z_][0-9a-zA-Z_]*)*\\s*)\\(",
			"beginCaptures": {
				"1": {
					"patterns": [
						{
							"include": "#declaration_functions"
						}
					]
				},
				"2": {
					"patterns": [
						{
							"include": "#types"
						}
					]
				},
				"3": {
					"name": "entity.name.function.pawn"
				},
				"4": {
					"name": "punctuation.section.parameters.begin.bracket.round.pawn"
				}
			},
			"end": "(?<=\\}|;|=)",
			"endCaptures": {
				"0": {
					"name": "punctuation.terminator.pawn"
				}
			},
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"begin": "\\G",
					"end": "\\)",
					"name": "meta.head.function.pawn",
					"endCaptures": {
						"0": {
							"name": "punctuation.section.parameters.end.bracket.round.pawn"
						}
					},
					"patterns": [
						{
							"include": "#ever_present_context"
						},
						{
							"include": "#parameter_or_maybe_value"
						},
						{
							"include": "#comma"
						},
						{
							"include": "#evaluation_context"
						}
					]
				},
				{
					"begin": "({)",
					"end": "(})",
					"name": "meta.body.function.definition.pawn",
					"beginCaptures": {
						"1": {
							"name": "punctuation.section.block.begin.bracket.curly.function.definition.pawn"
						}
					},
					"endCaptures": {
						"1": {
							"name": "punctuation.section.block.end.bracket.curly.function.definition.pawn"
						}
					},
					"patterns": [
						{
							"include": "#function_body_context"
						}
					]
				},
				{
					"begin": "\\s*(?=(?:return|if|while|for|break|continue|do|;|\\w+))",
					"end": ";",
					"name": "meta.body.function.definition.pawn",
					"beginCaptures": {},
					"endCaptures": {
						"0": {
							"name": "punctuation.terminator.statement.pawn"
						}
					},
					"patterns": [
						{
							"include": "#function_body_context"
						},
						{
							"include": "#evaluation_context"
						}
					]
				},
				
				{
					"begin": "(?<=\\))\\s*(?=;)",
					"end": ";",
					"name": "meta.function.declaration.pawn",
					"beginCaptures": {},
					"endCaptures": {
						"0": {
							"name": "punctuation.terminator.statement.pawn"
						}
					},
					"patterns": [
						{
							"include": "#ever_present_context"
						}
					]
				},
				{
					"begin": "(?<=\\))\\s*(?==)",
					"end": "(?=;)",
					"name": "meta.native.assignment.pawn",
