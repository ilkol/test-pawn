								}
							]						
						},
						{
							"include": "#number_literal"
						},
						{
							"include": "#evaluation_context"
						}
					]
				},
				{
					"include": "#evaluation_context"
				}
			]
		},
		"array_operators": {
			"patterns": [
				{
					"include": "#simple_array_operator"
				},
				{
					"include": "#char_array_operator"
				}
			]
		},
		"simple_array_operator": {
			"name": "meta.bracket.square.array.pawn",
			"begin": "\\[",
			"end": "\\]",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.begin.bracket.square.array.type.pawn"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.end.bracket.square.array.type.pawn"
				}
			},
			"patterns": [
				{
					"include": "#ever_present_context"
				},
				{
					"include": "#evaluation_context"
				},
				{
					"include": "#type_char"
				}
			]
		},
		"char_array_operator": {
			"name": "meta.bracket.curly.array.pawn",
			"begin": "\\{",
			"end": "\\}",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.begin.bracket.curly.array.type.pawn"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.end.bracket.curly.array.type.pawn"
				}
			},
			"patterns": [
				{
					"include": "#ever_present_context"
				},
				{
					"include": "#evaluation_context"
				},
				{
					"include": "#type_char"
				}
			]
		},
		"tags": {
			"match": "\\b((?:[\\w\\d_-]*)\\s*(?::))?\\s*([\\w\\d_-]+)",
			"captures":{
				"1": {
					"patterns": [
						{
							"include": "#types"
						}
					]
					
				},
				"2": {
					"name": "variable.other.pawn"
				}
			}
		},
		"type_name": {
			"match": "\\b(void|_|bool|Float)|([\\w\\d_-]+)\\b",
			"captures": {
				"1":{
					"patterns": [
						{
							"include": "#type_int"
						},
						{
							"match": "void|bool|Float",
							"name": "storage.$0.pawn"
						}
					]
					
				},
				"2": {
					"patterns": [
						{
							"include": "#type"
						}
					],
					"name": "storage.pawn"
				}
			}
		},
		"types":{
			"patterns": [
				{
					"begin": "{",
					"end": "}",
					"patterns": [
						{
							"include": "#type_name"	
						}
					]
				},
				{
					"include": "#type_name"	
				}
			]
			
		},
		"type":{
			"match": "[\\w\\d_-]*",
			"name": "entity.name.type.pawn"
		},
		"type_int":{
			"match": "\\b_\\b",
			"name": "storage.int.pawn"
		},
		"type_char":{
			"match": "\\bchar\\b",
			"name": "storage.char.pawn"
		},
		"storage_modifier":{
			"name": "storage.$1.modifier",
			"match": "\\b(const|static)\\b"
		},
		"keywords_operators":{
			"name": "keyword.control.operator.pawn",
			"match": "\\B(\\||&){2}\\B"
		},
		"punctuation_semicolon":{
			"name": "punctuation.terminator.statement.pawn",
			"match": ";"
		},
		"language_constants":{
			"name": "constant.language.pawn",
			"match": "\\b(true|false|EOS)\\b"
		},
		"keywords": {
			"patterns": [{
				"name": "keyword.control.$1.pawn",
				"match": "\\b(if|while|for|return|foreach|break|continue|do|else)\\b"
			}]
		}
		
	},
	"scopeName": "source.pawn"
}